{
    "Q": {
        "pluginInfo": {
            "Safecloud": {
                "version": "1.0.1",
                "compatible": "1.0",
                "requires": {
                    "Q": "1.0",
                    "Users": "1.0",
                    "Streams": "1.0"
                }
            }
        },
        "handlersBeforeEvent": {
            "Q/responseExtras": ["Safecloud/before/Q_responseExtras"]
        }
    },
    "Safecloud": {
        "requirePayment": false,
        "jetUrl": null,
        "drop": {
            "storageGB": 10,
            "offlineGraceMs": 60000,
            "balanceCacheTtlMs": 3600000,
            "sessionExpDays": 30,
            "claimThresholdSafebux": "100000",
            "claimBatchSize": 10,
            "minStakeSafebux": "0",
            "minSlashFailures": 3,
            "slashWindowMs": 3600000,
            "sbuxPerMB": 0.02
        },
        "safebux": {
            "address": null,
            "chainId": "eip155:56",
            "perChunkWei": "0"
        },
        "jet": {
            "address": null
        },
        "cors": {
            "allowedOrigins": ["*"]
        },
        "admin": {
            "sessionDurationHours": 8
        },
        "openclaiming": {
            "address": null
        },
        "wallet": {
            "privateKey": null
        },
        "swarm": {
            "enabled": false,
            "seed": null,
            "networkId": "safecloud:jet:v1",
            "secureIds": false,
            "bootstrap": null,
            "allowUnverifiedDelegations": false
        },
        "ipfs": {
            "enabled": false,
            "mode": "external",
            "apiUrl": null,
            "gatewayUrl": null,
            "pinningService": {
                "endpoint": null,
                "key": null,
                "exposedKey": null
            },
            "requireSafebux": false,
            "sbuxPerGB": 0
        },
        "storage": {
            "backend": "indexeddb",
            "localGB": 1000,
            "s3": {
                "endpoint": null,
                "region": "us-east-1",
                "bucket": null,
                "accessKeyId": null,
                "secretAccessKey": null,
                "forcePathStyle": false
            },
            "filesystem": {
                "storageDir": null
            },
            "webdav": {
                "url": null,
                "username": null,
                "password": null,
                "basePath": "/safecloud"
            },
            "arweave": {
                "host": "arweave.net",
                "port": 443,
                "protocol": "https",
                "timeout": 20000,
                "keyfile": null
            },
            "filecoin": {
                "endpoint": "https://api.web3.storage",
                "gatewayUrl": "https://w3s.link/ipfs",
                "key": null,
                "indexDir": null
            },
            "rclone": {
                "remote": null,
                "basePath": "safecloud",
                "rclonePath": "rclone",
                "timeout": 30000
            }
        }
    }
}
